// Copy to Secrets.xcconfig (gitignored) and fill in. Nothing here is tracked,
// so a clone builds without carrying anyone's deployment or key.
//
// A literal // inside a value starts a comment in xcconfig, so the scheme
// separator has to be escaped as /$()/ .
OPENPORTFOLIO_CONVEX_URL = https:/$()/your-deployment.convex.cloud
OPENPORTFOLIO_SERVICE_KEY =
// Only needed when one operator belongs to more than one book.
OPENPORTFOLIO_TENANT_SLUG =
// Your Apple Developer team, for signing a device build.
OPENPORTFOLIO_TEAM_ID =
