# Copy to .env.local. Values marked "deployment" also have to be set on the
# Convex deployment itself, which does not read this file:
#   npx convex env set <KEY> <VALUE>
#
# There is no model provider key here, and there is no place to add one. Every
# model call is a spawn of an agent CLI you are already signed in to. See
# actor.mts.

# --- Required ---------------------------------------------------------------

# Your Convex deployment, written by `npx convex dev` on first run.
CONVEX_DEPLOYMENT=

# Shared secret the workers and the MCP server present instead of a browser
# session. Generate with `openssl rand -hex 32`, then register only its hash:
#   npx convex run tenants:issueServiceKey '{"key":"<the key>","label":"sync-worker"}'
# One key maps to exactly one tenant and carries its own role. Never commit it;
# rotate it by issuing a new one and revoking the old label.
OPENPORTFOLIO_SERVICE_KEY=

# --- Multi-tenancy ----------------------------------------------------------

# Which book the workers act on. Only needed when one key's identity is
# ambiguous, which it never is for a service key; set it when you run a worker
# under a human identity that belongs to several tenants.
OPENPORTFOLIO_TENANT=

# Localhost escape hatch (deployment). While this names a tenant slug, any
# unauthenticated caller is scoped to that tenant. It exists so a fresh checkout
# can get its first book with nothing configured. Unset it before the deployment
# is reachable from the internet.
OPENPORTFOLIO_DEV_TENANT=

# Sign-in needs no variable here. Authentication is Convex Auth with a password,
# running inside your own deployment: `npx @convex-dev/auth` writes the signing
# keys onto the deployment itself and there is no identity provider to configure.
# The issuer is CONVEX_SITE_URL, which Convex sets.
#
# Set to 1 to let a caller who belongs to no tenant create a book after the first
# one exists (deployment). Off by default: Convex Auth will make an account for
# anyone who finds a public URL, and while the tenant gate stops them reading your
# book, an open door lets them spend your quota on their own.
OPENPORTFOLIO_OPEN_SIGNUP=

# --- Venue adapters ---------------------------------------------------------

# Path to a JSON array of manually maintained holdings. This is how a pension,
# a property or an unlisted holding gets into the total. See the README for the
# row shape. The file is gitignored by pattern; keep it outside the repo if you
# would rather not rely on that.
OPENPORTFOLIO_MANUAL_HOLDINGS=

# Which registered venue answers quote lookups for symbols the holding venue
# cannot price. Defaults to coingecko, which needs no key.
OPENPORTFOLIO_QUOTE_VENUE=

# A keyed broker adapter takes its credential from this file and from the worker
# process only. The backend never receives it. There is no example here because
# no keyed adapter ships.
