{
  "compilerOptions": {
    "target": "ES2022",
    // Unlike core and domain this package is node-only by design: it reads
    // files, talks to Convex over the wire and holds the venue adapters.
    // Nothing in convex/ or browser/ may import it.
    "lib": ["ES2022"],
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.tmp/node.tsbuildinfo"
  },
  "include": ["src"]
}
