# Copy to browser/.env.local. Vite only exposes variables prefixed VITE_.

# Written by `npx convex dev` at the repo root; copy the deployment URL here.
VITE_CONVEX_URL=

# Auth is ON by default, runs inside your own Convex deployment, and needs no
# key: Convex Auth with a password, no third-party account anywhere. Set this to
# 1 only to switch it off for local work, in which case OPENPORTFOLIO_DEV_TENANT
# must be set on the deployment and anyone who reaches the URL gets that book.
VITE_DISABLE_AUTH=
