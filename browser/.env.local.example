# Copy to browser/.env.local. Vite only exposes variables prefixed VITE_.

# Written by `npx convex dev` at the repo root; copy the deployment URL here.
VITE_CONVEX_URL=

# Clerk publishable key. Leave blank to run without auth on localhost, in which
# case OPENPORTFOLIO_DEV_TENANT must be set on the deployment.
VITE_CLERK_PUBLISHABLE_KEY=
